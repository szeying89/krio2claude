# Copy this file to .env (in this backend/ directory) and fill in the
# values you need. .env is gitignored -- never commit real secrets.
#
# Both app/core/config.py's Settings (every TM_-prefixed variable) and
# app/services/llm/keys.py::get_api_key (ANTHROPIC_API_KEY/OPENAI_API_KEY)
# read this file. Precedence for the LLM key specifically: a real
# environment variable wins over this file, which wins over the OS
# keyring (`python -m keyring set threatmodel-platform anthropic`).

# --- LLM provider credentials (not TM_-prefixed) ---
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Platform settings (all TM_-prefixed; see README's "Configuration" table) ---
# TM_LLM_PROVIDER=anthropic
# TM_LLM_MODEL=claude-sonnet-5
# TM_HOST=127.0.0.1
# TM_PORT=8000
# TM_DATA_DIR=./data
# TM_DATABASE_URL=sqlite+aiosqlite:///./app.db

# --- Security (see README's "Security" section; off/unset by default) ---
# TM_API_KEY=
# TM_RATE_LIMIT_PER_MINUTE=
